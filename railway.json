{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.tray",
    "watchPatterns": [
      "/cmd/tray/**",
      "/internal/**",
      "/go.mod",
      "/go.sum",
      "/Dockerfile.tray",
      "/railway.json"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ALWAYS"
  }
}
